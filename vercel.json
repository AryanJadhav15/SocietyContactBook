{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "buildCommand": "npx prisma generate",
    "installCommand": "npm install",
    "functions": {
        "server/api/index.js": {
            "maxDuration": 10
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/server/api"
        }
    ]
}
